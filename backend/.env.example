POSTGRES_DB=radoko
POSTGRES_USER=radoko
POSTGRES_PASSWORD=radoko_local_only
DATABASE_URL=postgresql://radoko:radoko_local_only@localhost:5433/radoko?schema=public
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
